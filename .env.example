#--------------------------------------------------------------------
# Seldon Task Management & Support Ticket System Configuration Example
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
#--------------------------------------------------------------------

database.default.hostname = 127.0.0.1
database.default.database = seldon_db
database.default.username = your_pg_username
database.default.password = your_pg_password
database.default.DBDriver = Postgre
database.default.DBPrefix =
database.default.port = 5432
database.default.schema = public

database.tests.hostname = 127.0.0.1
database.tests.database = seldon_db_test
database.tests.username = your_pg_username
database.tests.password = your_pg_password
database.tests.DBDriver = Postgre
database.tests.DBPrefix =
database.tests.port = 5432
database.tests.schema = public

#--------------------------------------------------------------------
# SECURITY / ENCRYPTION
# Generate a key using: php spark key:generate
#--------------------------------------------------------------------

encryption.key = 

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName = 'seldon_session'
session.expiration = 7200
session.savePath = null

#--------------------------------------------------------------------
# CSRF PROTECTION
#--------------------------------------------------------------------

security.csrfProtection = 'cookie'
security.tokenRandomize = true
security.tokenName = 'csrf_token_name'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie_name'
security.expires = 7200
security.regenerate = true
security.redirect = false
security.samesite = 'Lax'
