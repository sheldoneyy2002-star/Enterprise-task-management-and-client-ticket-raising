#--------------------------------------------------------------------
# Seldon Task Management & Support Ticket System Configuration
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
#--------------------------------------------------------------------

database.default.hostname = 127.0.0.1
database.default.database = seldon_db
database.default.username = postgres
database.default.password = root
database.default.DBDriver = Postgre
database.default.DBPrefix =
database.default.port = 5432
database.default.schema = public

database.tests.hostname = 127.0.0.1
database.tests.database = seldon_db_test
database.tests.username = postgres
database.tests.password = root
database.tests.DBDriver = Postgre
database.tests.DBPrefix =
database.tests.port = 5432
database.tests.schema = public

#--------------------------------------------------------------------
# SECURITY / ENCRYPTION
#--------------------------------------------------------------------

encryption.key = hex2bin:f796a5d7c3b246a81e3f892cb26871a3e6f982d61c714c35b89a4561230deabc

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName = 'seldon_session'
session.expiration = 7200
session.savePath = null
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = false

#--------------------------------------------------------------------
# CSRF PROTECTION
#--------------------------------------------------------------------

security.csrfProtection = 'cookie'
security.tokenRandomize = true
security.tokenName = 'csrf_token_name'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie_name'
security.expires = 7200
security.regenerate = true
security.redirect = false
security.samesite = 'Lax'

#--------------------------------------------------------------------
# EMAIL / SMTP NOTIFICATIONS (Gmail SMTP)
#--------------------------------------------------------------------
email.fromEmail = 'sheldoneyy2002@gmail.com'
email.fromName = 'Seldon Support System'
email.protocol = 'smtp'
email.SMTPHost = 'smtp.gmail.com'
email.SMTPUser = 'sheldoneyy2002@gmail.com'
email.SMTPPass = 'mxrw xdeq ehvi btys' # Paste your 16-character Google App Password here (e.g. abcd efgh ijkl mnop)
email.SMTPPort = 587
email.SMTPCrypto = 'tls'
email.mailType = 'html'

# Coordinator Notification Recipient
coordinator.notificationEmail = 'sheldoneyy2002@gmail.com'

